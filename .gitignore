# ---------------------------------------------------------------------------
# Restricted microdata must never be committed.
# The Korea Health Panel is released to named applicants under a data-use
# agreement that forbids redistribution, so neither the source SPSS files nor
# any person-level derivative of them belongs in this repository.
# ---------------------------------------------------------------------------
input/derived/
*.sav
*.sas7bdat
*.dta
*.por

# Keep the synthetic replica, the data dictionary and all results.
!input/synthetic/
!input/dictionary/

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
.env

# OS / editor
.DS_Store
desktop.ini
Thumbs.db
.idea/
.vscode/

# A synthetic demo run writes here; it is reproducible from the committed
# synthetic panel, so it does not need to be in the repository.
output/synthetic/
